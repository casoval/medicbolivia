# backend/Dockerfile.prod
# Variante de producción del backend — misma base que Dockerfile (dev),
# pero SIN --reload y con --workers 2 (igual que ecosystem.config.js hoy
# en PM2), para que el comportamiento sea idéntico al que ya corre en
# el VPS, solo que dentro de un contenedor.
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 4000

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "4000", "--workers", "2"]
