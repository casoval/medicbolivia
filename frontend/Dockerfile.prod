# syntax=docker/dockerfile:1.4
# frontend/Dockerfile.prod
# Build de producción de Next.js. Usa el frontend/.env.production que ya
# existe en el VPS (lo crea scripts/setup_frontend.sh) — Next.js lo lee
# automáticamente durante "pnpm build" porque NODE_ENV=production.
# frontend/Dockerfile.prod
# Variante de producción del frontend. Puerto 3002 (no 3000): en producción
# nginx proxya a 3002 a propósito, para poder correr este contenedor en
# paralelo al frontend de PM2 (puerto 3000) durante la migración a Docker
# sin que compitan por el mismo puerto — ver docker-compose.prod.yml y
# scripts/medicbolivia.nginx.
FROM node:20-slim AS builder

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
ENV NODE_ENV=production
# Cache mount: persiste .next/cache entre builds de imagen (no viaja a la
# imagen final, solo vive en el caché de BuildKit del host). Sin esto,
# cada "docker compose up --build" arranca a next build de cero, aunque
# solo haya cambiado 1 archivo — es lo que antes evitaba PM2 corriendo
# next build directo en el host, con .next/cache persistido en disco.
RUN --mount=type=cache,target=/app/.next/cache,sharing=locked \
    pnpm build

# ── Imagen final, más liviana ──────────────────────────
FROM node:20-slim
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9 --activate

ENV NODE_ENV=production
COPY --from=builder /app ./

EXPOSE 3002
CMD ["npx", "next", "start", "-p", "3002"]
